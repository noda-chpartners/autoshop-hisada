---
interface Props {
  name: "phone" | "pin" | "clock" | "train";
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "phone" && (
      <path d="M7.2 4.2h2.4l1.1 2.7-1.6 1a11 11 0 0 0 5 5l1-1.6 2.7 1.1v2.4c0 .7-.6 1.4-1.4 1.4A13.2 13.2 0 0 1 5.8 5.6c0-.8.6-1.4 1.4-1.4Z" />
    )
  }
  {
    name === "pin" && (
      <>
        <path d="M12 21s6-5.1 6-10a6 6 0 1 0-12 0c0 4.9 6 10 6 10Z" />
        <circle cx="12" cy="11" r="2.1" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <path d="M12 8v4.4L15.2 15" />
      </>
    )
  }
  {
    name === "train" && (
      <>
        <rect x="6" y="3.5" width="12" height="12.5" rx="2" />
        <path d="M6 10.5h12M8.2 20.2 10 16h4l1.8 4.2" />
        <circle cx="9.1" cy="13.2" r="0.7" fill="currentColor" stroke="none" />
        <circle cx="14.9" cy="13.2" r="0.7" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
