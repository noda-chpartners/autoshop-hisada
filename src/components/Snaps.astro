---
import { Image } from "astro:assets";
import { snaps } from "../data/gallery";
---

<section class="snaps" aria-labelledby="snaps-title">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">Gallery</p>
        <h2 id="snaps-title">店先のスナップ</h2>
      </div>
      <div class="snaps__controls">
        <button type="button" data-snaps-prev aria-label="前の写真">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" data-snaps-next aria-label="次の写真">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="snaps__scroller" data-snaps tabindex="0" data-lenis-prevent-touch>
    {
      snaps.map((snap) => (
        <figure class="snaps__item">
          <Image
            src={snap.image}
            alt={snap.alt}
            widths={[480, 720, 1080]}
            sizes="(min-width: 960px) 26vw, 70vw"
            quality={72}
            class="snaps__img"
          />
        </figure>
      ))
    }
  </div>
</section>
