---
import { Image } from "astro:assets";
import interior from "../assets/images/line_oa_chat_260915_104030.jpg";
import { site } from "../data/site";
---

<section class="visit" id="shop" aria-labelledby="shop-title">
  <div class="wrap visit__grid">
    <figure class="visit__figure reveal">
      <Image
        src={interior}
        alt="店内にスクーターが並んでいる。奥の壁にはバイクのカタログが貼ってある"
        widths={[720, 1080, 1440]}
        sizes="(min-width: 960px) 56vw, 100vw"
        quality={74}
        class="visit__img"
      />
    </figure>
    <div class="visit__copy reveal">
      <p class="kicker">Shop</p>
      <h2 id="shop-title">写真で迷ったら、見にきてください。</h2>
      <p>
        店内にはスクーターが並び、壁には昔のカタログが貼ってあります。色の具合や年式の雰囲気は、実車の前が一番わかります。
      </p>
      <ul class="visit__list">
        <li>
          <span>営業時間</span>
          <strong>{site.hours}</strong>
        </li>
        <li>
          <span>定休日</span>
          <strong class="is-ja">{site.closed}</strong>
        </li>
        <li>
          <span>電話</span>
          <strong><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></strong>
        </li>
      </ul>
    </div>
  </div>
</section>
