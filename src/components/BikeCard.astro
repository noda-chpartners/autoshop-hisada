---
import { Image } from "astro:assets";
import type { Bike } from "../data/bikes";
import { formatKm, formatPrice } from "../lib/format";

interface Props {
  bike: Bike;
  index: number;
}

const { bike, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const hasPhoto = bike.images.length > 0;
---

<article class="card reveal" id={bike.id}>
  <div class="card__media">
    {
      hasPhoto ? (
        <>
          {bike.images.map((image, imageIndex) => (
            <Image
              src={image}
              alt={bike.alts[imageIndex] ?? bike.name}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 100vw"
              quality={74}
              class:list={["card__img", imageIndex === 0 ? "card__img--main" : "card__img--alt"]}
            />
          ))}
        </>
      ) : (
        <div class="card__blank">
          <span class="card__blank-type">{bike.name}</span>
          <span class="card__blank-note">写真準備中</span>
        </div>
      )
    }
    <span class="card__num">{number}</span>
    <span class="card__maker">{bike.maker}</span>
  </div>
  <div class="card__body">
    <h3 class="card__name">
      {bike.name}
      {bike.spec && <small>{bike.spec}</small>}
    </h3>
    <p class="card__price"><span>¥</span>{formatPrice(bike.price)}</p>
    <dl class="card__meta">
      <div>
        <dt>走行</dt>
        <dd class="is-num">{formatKm(bike.mileage)}</dd>
      </div>
      <div>
        <dt>色</dt>
        <dd>
          <span class="swatch" style={`background:${bike.swatch}`} aria-hidden="true"></span>
          {bike.color}
        </dd>
      </div>
    </dl>
  </div>
</article>
