---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Stock from "../components/Stock.astro";
import Snaps from "../components/Snaps.astro";
import Visit from "../components/Visit.astro";
import Access from "../components/Access.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";

const title = "オートショップヒサダ｜日進市赤池の中古バイク店";
const description =
  "愛知県日進市赤池の中古バイク店、オートショップヒサダ。原付、スーパーカブ、モンキー、スクーターを店頭で販売。赤池駅から徒歩4、5分。10:00〜18:30、木曜定休。052-801-0519";
---

<Layout title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />
    <Intro />
    <Stock />
    <Snaps />
    <Visit />
    <Access />
    <Faq />
  </main>
  <Footer />
</Layout>
